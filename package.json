{
  "name": "birthday-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync-media && vite",
    "build": "tsc -b && vite build",
    "prebuild": "npm run sync-media",
    "build:store": "bash scripts/build-offstore.sh",
    "sync-media": "node scripts/sync-media.mjs",
    "compress-media": "node scripts/compress-media.mjs && npm run sync-media",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node scripts/serve-with-picks.mjs",
    "push:github": "node scripts/push-to-github.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ffmpeg-static": "^5.3.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
